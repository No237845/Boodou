# Copier en .env puis remplir.

# PostgreSQL hébergé (Neon, Supabase, Railway, Render...). L'URL fournie par
# l'hébergeur fonctionne telle quelle (postgres:// ou postgresql://).
DATABASE_URL=postgresql://user:password@host:5432/alertsecurite?sslmode=require

# Clé de chiffrement des récits, générée par `python -m scripts.gen_keys`.
# À sauvegarder hors serveur : la perdre = perdre tous les signalements.
REPORT_SECRET_KEY=

# Ancien schéma (avant la refonte « circuit VBG »). Peut rester vide sur une
# installation neuve. Sert à `python -m scripts.reencrypt` pour relire les
# signalements créés avant la refonte, avec REPORT_PRIVATE_KEY dans l'environnement.
REPORT_PUBLIC_KEY=

# Clé d'accès à /admin (gestion des comptes acteurs, vue d'ensemble)
ADMIN_KEY=change-me

# Durée des sessions acteurs (secondes) : web 8 h, application mobile 30 jours
ACTOR_SESSION_TTL_WEB=28800
ACTOR_SESSION_TTL_MOBILE=2592000

# Site neutre du bouton "Quitter vite"
QUICK_EXIT_URL=https://www.google.com

# --- WhatsApp Cloud API (Meta) — voir README, section WhatsApp ---
# Jeton inventé par vous, recopié dans Meta > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=change-me-verify
# Meta > WhatsApp > API Setup > "Temporary access token" (24 h) ou jeton System User (permanent)
WHATSAPP_ACCESS_TOKEN=
# Meta > WhatsApp > API Setup > "Phone number ID" (l'identifiant, pas le numéro)
WHATSAPP_PHONE_NUMBER_ID=
# Meta > Paramètres de l'app > Général > "Clé secrète" — vérifie la signature des webhooks
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- SMS (Africa's Talking) — voir README, section SMS ---
# "sandbox" pour tester, sinon le nom d'utilisateur du compte live
AT_USERNAME=sandbox
# Africa's Talking > Settings > API Key
AT_API_KEY=
# Shortcode loué ou sender ID alphanumérique validé. Vide = numéro partagé (OK en sandbox)
AT_SENDER_ID=
# Jeton inventé par vous, à ajouter à l'URL de callback déclarée chez AT :
#   https://votre-domaine/webhooks/sms?token=CE_JETON
# Leurs callbacks ne sont pas signés : sans ce jeton, n'importe qui peut poster de faux SMS.
SMS_WEBHOOK_TOKEN=

# Sel pour hacher les numéros de téléphone (session du bot, en mémoire uniquement)
BOT_PHONE_SALT=change-me-too

# Origines autorisées à appeler /api depuis un navigateur (app mobile en mode
# web). Séparées par des virgules ; "*" pour toutes. Inutile pour Expo Go / APK.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Assistant de reformulation (app/api_ai) ---
# Clé OpenAI. Vide = le bouton « Proposer une reformulation » n'apparaît nulle part.
# ⚠ Avec une clé, le récit d'un signalement est envoyé à OpenAI quand un relais
# demande une proposition : à valider avec les partenaires avant la production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Dictée vocale (app/api_ai/transcribe.py) ---
# Clé Gladia (https://app.gladia.io). Vide = pas de bouton « Parler au lieu d'écrire ».
# ⚠ Avec une clé, l'enregistrement vocal est envoyé à Gladia pour transcription
# (rien n'est conservé côté serveur). À valider avec les partenaires.
GLADIA_API_KEY=
GLADIA_MODEL=solaria-1

# --- Traduction français -> mooré (app/api_ai/translate.py) ---
# Clé Burkimbia (https://api.burkimbia.com). Sert au script
# scripts/translate_locales.py (interface, hors ligne) et, en production, à
# traduire en tâche de fond l'annuaire et les notes des acteurs. Vide = ce
# contenu reste en français quand la personne est en mooré.
# Seul du contenu public ou destiné à la personne y passe, jamais un récit.
BURKIMBIA_API_KEY=
BURKIMBIA_MODEL=bia-translation-v1-fast
